# -*-mode:gitignore-*- vim:ft=gitignore

# ~/.local/share/chezmoi/.chezmoiignore
# =============================================================================
# Read by chezmoi when chosing repository files to copy to home directory.
#
# This list defines globs to ignore, and supports Go's text/template language.
# See https://www.chezmoi.io/docs/reference/#chezmoiignore

LICENSE
README.md
Brewfile

# ~/.claude — NOT managed anymore (dot_claude removed from this repo).
.claude

# ~/.dsh — manage only the static configuration. Everything else is secrets,
# runtime state, caches, or reproducible via `dsh plugin add`.
#
# Managed: .dsh/cordis.patch.yml, .dsh/profiles/desktop/{package.json,cordis.yml,cordis.patch.yml}
#
# Secrets — never commit tokens, API keys, or the device identity.
.dsh/.credentials.yaml
.dsh/.anonymous-user-id
.dsh/llm-deepseek

# Runtime state, user content, and caches.
.dsh/sessions
.dsh/attachments
.dsh/cache
.dsh/storages

# Reproducible or generated: plugin deps, lockfile, browser helper build.
.dsh/profiles/*/node_modules
.dsh/profiles/*/pnpm-lock.yaml
.dsh/profiles/*/pnpm-workspace.yaml
.dsh/dsh-browser

# Local backups written by plugin-manager / upgrades.
.dsh/profiles/*/*.bak*
.dsh/profiles/*/*.before-*

# Ignore non-MacOS files.
{{ if ne .chezmoi.os "darwin" }}
Library
.config
.hammerspoon
.warp
.lrzsz
.unison
{{ end }}

